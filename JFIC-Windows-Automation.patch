+[CmdletBinding()]
+param(
+    [switch]$PurgeConfig,
+    [switch]$PurgeBackups,
+    [switch]$NoRestart
+)
+
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'Jfic.Windows.Common.ps1')
+
